# =============================================================================
# Configuration — copier vers .env puis adapter :   cp .env.example .env
# =============================================================================

# --- Console web -------------------------------------------------------------
# En conteneur, garder 0.0.0.0 pour que l'UI soit joignable.
# ⚠️ Penser à filtrer l'accès au port (pare-feu / reverse-proxy auth).
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Sortie centralisée (VOTRE ELK allégé, connu d'avance) -------------------
# Type : logstash (recommandé) ou elasticsearch
FILEBEAT_OUTPUT_TYPE=logstash
# Adresse du collecteur. En "box unique" (ELK + console côté hôte), localhost.
FILEBEAT_OUTPUT_HOST=127.0.0.1:5044

# TLS Filebeat -> collecteur (recommandé en prod)
FILEBEAT_TLS_ENABLED=false

# --- Valeurs par défaut de l'UI (pré-remplissage, facultatif) ----------------
# Sous-réseaux proposés au scan (séparés par des virgules)
DEFAULT_CIDRS=192.168.1.0/24
# Utilisateur SSH par défaut pour Linux/FreeBSD
DEFAULT_SSH_USER=admin

# --- Identifiants bootstrap GÉNÉRAUX (compte admin commun au parc) ------------
# Servent au "seeding" de la clé. Surchargeables machine par machine dans l'UI
# pour les postes qui n'ont pas ce compte. Le mot de passe peut rester ici
# (fichier local, gitignoré) OU être laissé vide et saisi dans l'interface.
BOOTSTRAP_USER=admin
BOOTSTRAP_PASSWORD=
# Timeout TCP par port (secondes)
SCAN_TIMEOUT=0.6

# --- Inventaire persistant ---------------------------------------------------
# Fichier JSON de l'inventaire de parc (monté en volume Docker pour le conserver).
INVENTORY_FILE=/app/data/inventory.json
